<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#212C3D" />
            <stroke android:width="1dp" android:color="#3B82F6" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0F131A" />
            <stroke android:width="1dp" android:color="#1A212D" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151B26" />
            <stroke android:width="1dp" android:color="#2A374A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
