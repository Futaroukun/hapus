<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#222C3D" />
            <stroke android:width="1dp" android:color="#3B82F6" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#12161E" />
            <stroke android:width="1dp" android:color="#1B212B" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181F2C" />
            <stroke android:width="1dp" android:color="#2B3648" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
